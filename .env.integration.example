# Stage 5A integration gate: settings for the DEVELOPMENT Supabase project only.
#
# Copy this file to .env.integration.local (git-ignored) and fill it in there.
# Never put production values in it, and never put them in this example file.
# See scripts/integration/README.md.

# The development project's ref: the part before .supabase.co in its URL. Typed
# out on its own on purpose; every command checks the URL below against it.
FN_DEV_PROJECT_REF=

# The development project's URL, https://<ref>.supabase.co, nothing after it.
FN_DEV_SUPABASE_URL=

# The development project's PUBLISHABLE key (sb_publishable_...). A secret or
# service-role key is refused: nothing here needs one.
FN_DEV_SUPABASE_PUBLISHABLE_KEY=

# Projects the integration commands must never touch, comma-separated refs.
# Put your production project's ref here. The project your app's own .env files
# point at (VITE_SUPABASE_URL) is protected automatically as well.
FN_PROTECTED_PROJECT_REFS=

# Only for integration:dev:plan, integration:dev:migrate and
# integration:dev:verify: the development project's Session pooler connection
# string (port 5432), with its database password in it. Leave it empty if you
# apply the migrations through the SQL editor instead
# (npm run integration:dev:export-sql).
#   postgresql://postgres.<ref>:<url-encoded password>@<region>.pooler.supabase.com:5432/postgres
FN_DEV_DB_URL=

# Optional: Supabase's CA certificate for the database (Database settings >
# SSL Configuration > Download certificate), so the connection's certificate is
# verified. Without it the connection is still encrypted, but not verified.
FN_DEV_DB_CA_FILE=

# Optional limits. The gate needs 6 anonymous sign-ins per run.
FN_DEV_MAX_SIGNINS=8
FN_DEV_RACE_TRIALS=3
